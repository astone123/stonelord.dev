---
import "@fontsource-variable/bricolage-grotesque";
import "../base.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f2f1ec" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101013" />
    <title>Not found · stonelord.dev</title>
  </head>
  <body class="bg-paper text-ink dark:bg-ink dark:text-paper font-sans antialiased">
    <div class="mx-auto flex min-h-svh w-full max-w-[980px] flex-col px-6 pb-10 pt-8 sm:px-12 sm:pt-12 lg:px-16">
      <header class="flex items-start justify-between">
        <a href="/" class="no-underline text-sm font-semibold tracking-[0.02em]">stonelord.dev</a>
      </header>
      <main class="mt-10 sm:mt-12">
        <h1 class="text-balance text-[clamp(2.5rem,9vw,4.5rem)] font-extrabold leading-none tracking-[-0.02em]">
          Not<span class="text-accent dark:text-accent-dark">-</span>Found
        </h1>
        <p class="mt-5 max-w-[700px] text-[19px] leading-relaxed text-body dark:text-body-dark">
          There's nothing at this address. <a href="/">Back to the front page</a>.
        </p>
      </main>
      <footer class="mt-auto flex items-baseline justify-between gap-4 pt-14 text-[13px] text-muted dark:text-muted-dark">
        <span>© 2026 Adam Stone-Lord</span>
      </footer>
    </div>
  </body>
</html>

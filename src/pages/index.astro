---
import "@fontsource-variable/bricolage-grotesque";
import "../base.css";

const rows = [
  {
    n: "01",
    title: "Work",
    desc: "AI features for Cypress, most recently Studio AI, which generates tests inside the Cypress app",
    href: "https://www.cypress.io/app#test_generation",
  },
  {
    n: "02",
    title: "PopOff",
    desc: "Follower counts for Love Island, The Traitors, and other reality shows, sampled around the clock. Rebuilt in 2026 around a REST API and an MCP server for AI agents.",
    href: "https://popoff.tv",
  },
  {
    n: "03",
    title: "GitHub",
    desc: "github.com/astone123",
    href: "https://github.com/astone123/",
  },
  {
    n: "04",
    title: "LinkedIn",
    desc: "in/adam-stone-lord",
    href: "https://www.linkedin.com/in/adam-stone-lord-a9b9aaa8/",
  },
  {
    n: "05",
    title: "Email",
    desc: "adam@stonelord.dev",
    href: "mailto:adam@stonelord.dev",
  },
];

const description =
  "Adam Stone-Lord is a software engineer at Cypress. He also runs PopOff, a reality-TV analytics service with a REST API and an MCP server for AI agents.";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Adam Stone-Lord",
  url: "https://stonelord.dev/",
  jobTitle: "Software Engineer",
  sameAs: [
    "https://github.com/astone123/",
    "https://www.linkedin.com/in/adam-stone-lord-a9b9aaa8/",
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://stonelord.dev/" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f2f1ec" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101013" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://stonelord.dev/" />
    <meta property="og:title" content="Adam Stone-Lord" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://stonelord.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Adam Stone-Lord · stonelord.dev</title>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body class="bg-paper text-ink dark:bg-ink dark:text-paper font-sans antialiased">
    <div class="mx-auto flex min-h-svh w-full max-w-[980px] flex-col px-6 pb-10 pt-8 sm:px-12 sm:pt-12 lg:px-16">
      <header class="flex items-start justify-between">
        <a href="/" class="no-underline text-sm font-semibold tracking-[0.02em]">stonelord.dev</a>
        <img
          src="/profile-192.jpg"
          alt="Adam Stone-Lord"
          width="192"
          height="192"
          class="block h-14 w-14 object-cover grayscale contrast-[1.05] transition-[filter] duration-300 hover:grayscale-0 motion-reduce:transition-none"
        />
      </header>

      <main class="mt-10 sm:mt-12">
        <h1 class="text-balance text-[clamp(2.5rem,9vw,4.5rem)] font-extrabold leading-none tracking-[-0.02em]">
          Adam Stone<span class="text-accent dark:text-accent-dark">-</span>Lord
        </h1>
        <p class="mt-5 max-w-[700px] text-[19px] leading-relaxed text-body dark:text-body-dark">
          I build test tooling for a living and track reality-TV fame on the side.
        </p>

        <ul class="mt-9 list-none border-t-2 border-ink p-0 dark:border-paper">
          {
            rows.map((row) => (
              <li class="border-b border-hairline dark:border-hairline-dark">
                <a
                  href={row.href}
                  class="group grid grid-cols-[2rem_minmax(0,1fr)_1.25rem] items-center gap-x-5 py-4 no-underline sm:grid-cols-[2.75rem_12.5rem_minmax(0,1fr)_1.25rem]"
                >
                  <span class="text-xs font-semibold tabular-nums text-accent dark:text-accent-dark">{row.n}</span>
                  <span class="flex min-w-0 flex-col gap-1 sm:contents">
                    <span class="text-[17px] font-semibold leading-snug transition-colors group-hover:text-accent dark:group-hover:text-accent-dark motion-reduce:transition-none">
                      {row.title}
                    </span>
                    <span class="text-sm leading-relaxed text-muted dark:text-muted-dark">{row.desc}</span>
                  </span>
                  <svg
                    class="h-3.5 w-3.5 text-accent transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 dark:text-accent-dark motion-reduce:transition-none motion-reduce:group-hover:transform-none"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17L17 7" />
                    <path d="M8 7h9v9" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </main>

      <footer class="mt-auto flex items-baseline justify-between gap-4 pt-14 text-[13px] text-muted dark:text-muted-dark">
        <span>© 2026 Adam Stone-Lord</span>
        <span class="text-right">
          Built with <a href="https://astro.build">Astro</a> · <a
            href="https://github.com/astone123/stonelord.dev">Source</a>
        </span>
      </footer>
    </div>
  </body>
</html>
